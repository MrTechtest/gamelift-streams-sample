# ============================================================================
#  Configuration for the Amazon GameLift Streams sample.
#  Edit the values below, then run the numbered scripts in order.
# ============================================================================

# AWS region (Tokyo is supported as both a primary and a streaming location).
export AWS_REGION="ap-northeast-1"

# --- where the build comes from ---------------------------------------------
# Set PREBUILT_SOURCE_URI when the build is ALREADY in S3 (must be an
# uncompressed folder in the same region as AWS_REGION). 10-upload-and-create-app.sh
# then skips bucket creation and upload entirely and uses this URI as-is.
# Leave it empty to build locally and upload BUILD_DIR to BUILD_BUCKET instead.
export PREBUILT_SOURCE_URI="s3://bgbjbjbifzsgr/test_gamesample/Windows"

# Only used when PREBUILT_SOURCE_URI is empty.
export BUILD_BUCKET="glstreams-sample-tom-northeast-1"
export BUILD_DIR="../game/dist"

# The launch path relative to the build root. For an Unreal Engine packaged
# Windows build this is the top-level launcher .exe, not the one under
# <Project>/Binaries/Win64/ (that one is launched by the shim).
export EXECUTABLE_PATH="MyProject.exe"

# Operating system / compatibility layer the application runs under. Must match
# the OS of STREAM_CLASS below:
#   UBUNTU / 22_04_LTS  -> Linux classes  (gen6n_small, gen6n_medium, ...)
#   WINDOWS / 2022      -> *_win2022 classes
#   PROTON  / 20260204  -> Windows build on a Linux class (DX12 -> Vulkan)
export RUNTIME_TYPE="WINDOWS"
export RUNTIME_VERSION="2022"

# Human-readable labels.
export APP_DESCRIPTION="glstreams-ue5-myproject"
export SG_DESCRIPTION="glstreams-ue5-streamgroup"

# Stream hardware class. gen6n_small_win2022 = 2 vCPU / 8 GB RAM / 3 GB VRAM,
# Windows Server 2022 with DirectX 12, one session per host.
export STREAM_CLASS="gen6n_small_win2022"

# Capacity, in stream slots, which must be a multiple of the class tenancy
# (sessions per host). gen6n_small_win2022 hosts 1 session, so any value works;
# the Linux gen6n_small hosts 12, which is why it rejects anything but
# multiples of 12.
#
# ALWAYS_ON keeps hosts warm: streams start instantly, but the GPU bills
# continuously whether or not anyone is playing. ON_DEMAND provisions a host
# when a stream is requested: no idle charge, but the first start of a session
# waits a few minutes for provisioning.
#
# Default below = on-demand only, which is the safe choice for a sample.
export ALWAYS_ON_CAPACITY="0"
export ON_DEMAND_CAPACITY="1"

# ---------------------------------------------------------------------------
# These are filled in automatically by the scripts and read by the web app.
# You normally do not edit them by hand; they are written to state.env.
# ---------------------------------------------------------------------------
export STATE_FILE="state.env"
if [ -f "$STATE_FILE" ]; then
  source "$STATE_FILE"
fi
